public func SDP_TrainingThreshold(grade: Int32) -> Int32 {
  if grade == 1 { return 150; };
  if grade == 2 { return 160; };
  if grade == 3 { return 170; };
  if grade == 4 { return 180; };
  if grade == 5 { return 190; };
  if grade == 6 { return 200; };
  if grade == 7 { return 220; };
  if grade == 8 { return 240; };
  if grade == 9 { return 260; };
  if grade == 10 { return 280; };
  if grade == 11 { return 300; };
  return 0;
}

