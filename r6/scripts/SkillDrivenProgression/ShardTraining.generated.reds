  if source == 15 { return 11; };
  return 0;
}

public func SDP_TrainingDeadeyeAward(source: Int32, grade: Int32) -> Int32 {
  if source == 1 && grade >= 1 { return grade == 1 ? 2 : 1; };
  if source == 2 && grade >= 2 { return grade == 2 ? 2 : 1; };
  if source == 3 && grade >= 2 { return grade == 2 ? 2 : 1; };
  if source == 4 && grade >= 2 { return grade == 2 ? 2 : 1; };
  if source == 5 && grade >= 3 { return grade == 3 ? 2 : 1; };
  if source == 6 && grade >= 4 { return grade == 4 ? 2 : 1; };
  if source == 7 && grade >= 4 { return grade == 4 ? 2 : 1; };
  if source == 8 && grade >= 5 { return grade == 5 ? 2 : 1; };
  if source == 9 && grade >= 6 { return grade == 6 ? 2 : 1; };
  if source == 10 && grade >= 7 { return grade == 7 ? 2 : 1; };
  if source == 11 && grade >= 7 { return grade == 7 ? 2 : 1; };
  if source == 12 && grade >= 8 { return grade == 8 ? 2 : 1; };
  if source == 13 && grade >= 9 { return grade == 9 ? 2 : 1; };
  if source == 14 && grade >= 10 { return grade == 10 ? 2 : 1; };
  if source == 15 && grade >= 11 { return grade == 11 ? 2 : 1; };
  return 0;
}

